{
  "name": "@livelayer/sdk",
  "version": "0.10.0",
  "description": "LiveLayer Agent Widget — drop-in web component for embedding LiveLayer agents",
  "keywords": [
    "livelayer",
    "ai-agent",
    "voice-agent",
    "avatar",
    "livekit",
    "web-component",
    "widget"
  ],
  "homepage": "https://livelayer.studio",
  "main": "dist/widget.js",
  "module": "dist/widget.mjs",
  "types": "dist/widget.d.ts",
  "exports": {
    ".": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.mjs",
      "require": "./dist/widget.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.umd.config.ts && vite build --config vite.bridge.config.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "livekit-client": "^2.23.0"
  },
  "devDependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@microsoft/api-extractor": "^7.59.4",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fusion-Studios-Code/live-layer-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Fusion-Studios-Code/live-layer-sdk/issues"
  }
}
